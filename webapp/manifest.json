{
  "_version": "1.12.0",
  "sap.app": {
    "id": "com.sap.stockmovement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "phone": true,
      "tablet": true,
      "desktop": false
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.sap.stockmovement.view.App",
      "type": "XML"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.m": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.sap.stockmovement.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "com.sap.stockmovement.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "pattern": "",
          "name": "stockmovement",
          "target": "stockmovement"
        }
      ],
      "targets": {
        "stockmovement": {
          "viewName": "StockMovement",
          "viewLevel": 1
        }
      }
    }
  }
}
